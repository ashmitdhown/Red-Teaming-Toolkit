# AEGIS-GHOST Environment Variables
# Copy this file to .env and fill in your keys (optional)

# Groq API Keys — get a free key at https://console.groq.com
# Required for live AI audit report narratives, Causal Agent fixes, and AEGIS-AI chat.
# Note: Without these, all 50 attack vectors, execution runners, JSD math, and PDF reports still work using local deterministic templates.
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_SUGGESTIONS_API_KEY=your_groq_api_key_here
VITE_GROQ_REPORT_API_KEY=your_groq_api_key_here
